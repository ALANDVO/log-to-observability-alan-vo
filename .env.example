# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEMO_MODE=true

# Database
DATABASE_URL="sqlite:///./data/observability.db"

# LLM Configuration (Optional advisory assistance)
# LLM_API_KEY is the only secret LLM variable. Leave blank to run offline deterministic core.
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# OIDC / Keycloak Authentication
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/observability
OIDC_CLIENT_ID=observability-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=observability-app
JWT_SECRET=
